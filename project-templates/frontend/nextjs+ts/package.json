{
    "name": "nextjs-ts",
    "private": true,
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
    },
    "author": "wayne",
    "description": "A Next.js + TypeScript project template (App Router), aligned in complexity with vite-react+ts.",
    "scripts": {
        "dev": "next dev",
        "start": "next start",
        "build": "tsc && next build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css}\"",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "next": "^16.4.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.14",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.14.12",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "autoprefixer": "^10.4.21",
        "eslint": "^10.13.0",
        "eslint-config-next": "^16.4.3",
        "jest": "^30.4.2",
        "postcss": "^8.5.6",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.1.14",
        "ts-jest": "^29.4.11",
        "typescript": "^5.9.2"
    }
}
