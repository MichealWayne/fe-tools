{
  "name": "vite-vue3",
  "private": true,
  "version": "0.1.0",
  "author": "wayne",
  "task": "test",
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "build": "vue-tsc --noEmit && vite build --mode staging",
    "build:prod": "vue-tsc --noEmit && vite build --mode production && node build/index",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,less,css}\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "less": "^4.6.7",
    "less-loader": "^13.0.0",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
