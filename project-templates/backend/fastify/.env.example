
# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api
LOG_LEVEL=info

# Logging
LOG_DIR=logs
LOG_MAX_FILE_SIZE=10485760  # 10MB
LOG_MAX_FILES=7
ERROR_LOG_FILE=error.log
APP_LOG_FILE=app.log
ERROR_LOG_LEVEL=error

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Database
DATABASE_URL=postgres://user:password@localhost:5432/fastify_db

# Swagger
# Defaults to enabled in development and disabled in production.
# Set SWAGGER_ENABLED=true explicitly if the production API docs should be public.
