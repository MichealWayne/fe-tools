{
    "name": "nestjs-template",
    "version": "1.0.0",
    "port": "5000",
    "author": "Wayne",
    "description": "nestjs nodejs server template.",
    "main": "dist/main.js",
    "scripts": {
        "start": "tsc && node dist/main.js",
        "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
        "build": "rm -rf dist/* && tsc",
        "build:prod": "tsc && rm -rf node_modules && npm install --production",
        "install:prod": "npm install --production",
        "docker:start": "npm install && node dist/main.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "jest",
        "test:watch": "jest --watch"
    },
    "keywords": [
        "nestjs",
        "nodejs"
    ],
    "license": "ISC",
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.64.0",
        "@typescript-eslint/parser": "^8.64.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.1",
        "eslint": "^10.7.0",
        "jest": "^30.4.2",
        "prettier": "^3.9.5",
        "ts-jest": "^29.4.11",
        "ts-node-dev": "^2.0.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.28",
        "@nestjs/core": "^11.1.28",
        "@nestjs/platform-fastify": "^11.1.28",
        "fastify": "^5.10.0",
        "log4js": "^6.9.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    }
}
