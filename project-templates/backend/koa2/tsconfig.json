{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "sourceMap": false,
    "allowJs": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "lib": ["ES2021"],
    "outDir": "./dist",
    "rootDir": "./src/",
    "types": ["./src/types/"],
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
