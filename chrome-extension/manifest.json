{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.6.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "__MSG_extensionActionTitle__",
    "default_popup": "index.html"
  },
  "homepage_url": "https://github.com/MichealWayne/fe-tools",
  "permissions": [
    "contextMenus",
    "activeTab",
    "tabs",
    "bookmarks",
    "webRequest",
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "downloads"
  ],
  "host_permissions": ["*://*/*"],
  "omnibox": { "keyword": "fe" },
  "background": {
    "service_worker": "scripts/backgroundV3.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "<all_urls>"],
      "js": ["scripts/message-contract.js", "scripts/content-script-v3.js"]
    }
  ]
}
