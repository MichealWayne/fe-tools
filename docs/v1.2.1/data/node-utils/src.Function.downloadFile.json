, <span class=\"pl-s\"><span class=\"pl-pds\">'</span>./downloads/file.pdf<span class=\"pl-pds\">'</span></span>)\n  .<span class=\"pl-c1\">then</span>(<span class=\"pl-v\">filePath</span> <span class=\"pl-k\">=></span> <span class=\"pl-c1\">console</span>.<span class=\"pl-c1\">log</span>(<span class=\"pl-s\"><span class=\"pl-pds\">`</span>Downloaded to ${<span class=\"pl-smi\">filePath</span>}<span class=\"pl-pds\">`</span></span>))\n  .<span class=\"pl-c1\">catch</span>(<span class=\"pl-v\">err</span> <span class=\"pl-k\">=></span> <span class=\"pl-c1\">console</span>.<span class=\"pl-c1\">error</span>(<span class=\"pl-smi\">err</span>));\n</code></pre>\n<h5>Example:</h5><pre><code class=\"language-ts\"><span class=\"pl-c\">// Limit redirects</span>\n<span class=\"pl-en\">downloadFile</span>(<span class=\"pl-s\"><span class=\"pl-pds\">'</span>https://example.com/file.pdf<span class=\"pl-pds\">'</span></span>, <span class=\"pl-s\"><span class=\"pl-pds\">'</span>./file.pdf<span class=\"pl-pds\">'</span></span>, { maxRedirects: <span class=\"pl-c1\">2</span> });\n</code></pre>\n"},"sources":[{"fileName":"packages/node-utils/src/http/index.ts","fullFileName":"/home/runner/work/fe-tools/fe-tools/utils/packages/node-utils/src/http/index.ts","line":76,"character":0,"url":"https://github.com/MichealWayne/fe-tools/blob/10fb49f/utils/packages/node-utils/src/http/index.ts#L76"}],"parentId":2288}],"is":{"declaration":true},"location":{"query":"node-utils/src.Function.downloadFile","hash":""},"text":{},"parentId":965}
